# Flash / partition
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# CPU
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# SPIRAM (octal; refined in sdkconfig.defaults.esp32s3)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=2048
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=98304
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# Wi-Fi buffers: match 太空舱. Default 16/32 static buffers starve the wifi task after AFE.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=3
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER=y
CONFIG_ESP_WIFI_TX_BUFFER_TYPE=1
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=32
CONFIG_ESP_WIFI_DYNAMIC_RX_MGMT_BUFFER=y
CONFIG_ESP_WIFI_DYNAMIC_RX_MGMT_BUF=1
CONFIG_ESP_WIFI_RX_BA_WIN=3
# CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT is not set

# FreeRTOS
CONFIG_FREERTOS_HZ=1000

# LVGL basics (component Kconfig when present)
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_MEM_CUSTOM=y
CONFIG_LV_USE_LOG=y
CONFIG_LV_USE_LABEL=y
CONFIG_LV_FONT_MONTSERRAT_20=y
# Meet CJK comes from main/ui/fonts/font_meet_cjk_16_4.c (GB2312 + UI glyphs).
# CONFIG_LV_FONT_SOURCE_HAN_SANS_SC_16_CJK is not set

# ES8388 (太空舱 codec)
CONFIG_CODEC_ES8388_SUPPORT=y

# TLS / HTTP
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_ESP_TLS_USING_MBEDTLS=y
# ZeroSSL/Sectigo RSA-3072/4096 verify OOMs in internal DRAM (PSA -141).
CONFIG_MBEDTLS_DEFAULT_MEM_ALLOC=y
# CONFIG_MBEDTLS_INTERNAL_MEM_ALLOC is not set
CONFIG_MBEDTLS_CUSTOM_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CUSTOM_CERTIFICATE_BUNDLE_PATH="main/certs/meet_ca.pem"

# Meet defaults (projbuild)
CONFIG_MEET_SERVER_URL="https://meet.refme.cc"
CONFIG_MEET_IDLE_HANGUP_MS=90000
CONFIG_MEET_USE_DEVICE_AEC=y
CONFIG_MEET_FIRMWARE_VERSION="0.3.0"

# OTA rollback — mark valid only after first successful backend contact
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Wake word: 嗨乐鑫 (packed into the `model` partition)
CONFIG_MODEL_IN_FLASH=y
CONFIG_SR_WN_WN9_HILEXIN=y
